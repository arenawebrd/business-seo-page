---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locations } from '../../data/locations';
import { business } from '../../data/business';
---

<BaseLayout
  title="Service areas — Plumbing Co"
  description="Licensed plumbers serving Prahran, South Yarra, Windsor, St Kilda, Armadale, Toorak, Malvern, Caulfield, Elwood, Brighton. Same-day across Melbourne's inner south."
  canonical="/locations/"
>
  <section class="container-x pt-10 pb-20 md:pt-16">
    <header class="mx-auto max-w-3xl text-center">
      <div class="eyebrow">Locations</div>
      <h1 class="mt-3 font-display text-4xl font-bold leading-[1.05] tracking-tightest md:text-6xl">
        Where we fix things. <span class="squiggle">Every day.</span>
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-ink/70">
        We keep our service radius tight so our vans are never more than 20 minutes from your
        address. That's how same-day actually works.
      </p>
    </header>

    <div class="mx-auto mt-14 grid max-w-4xl gap-4 sm:grid-cols-2 md:grid-cols-3">
      {locations.map((loc) => (
        <a
          href={`/locations/${loc.slug}/`}
          class="group flex items-center justify-between rounded-2xl border border-ink/10 bg-white p-6 shadow-card transition-all hover:border-brand/30 hover:shadow-xl"
        >
          <div>
            <div class="font-display text-lg font-bold tracking-tight text-ink">
              {loc.suburb}
            </div>
            <div class="mt-1 text-sm text-ink/60">{loc.distance}</div>
          </div>
          <div class="grid h-10 w-10 place-items-center rounded-full bg-brand-soft text-brand transition-colors group-hover:bg-brand group-hover:text-white">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden>
              <path d="M3 7h8m-3-4 4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    {/* CTA — matches homepage FinalCta */}
    <section id="contact" class="container-x mt-16">
      <div class="relative overflow-hidden rounded-3xl border border-ink/10 bg-paper p-10 md:p-16">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(600px_300px_at_80%_10%,rgba(91,75,255,0.12),transparent_60%)]"
        />
        <div class="relative grid grid-cols-1 items-center gap-8 md:grid-cols-12">
          <div class="md:col-span-7">
            <h2 class="font-display text-3xl font-bold leading-[1.05] tracking-tightest md:text-5xl">
              Not in the list?<br />
              We might still help.
            </h2>
            <p class="mt-4 max-w-xl text-ink/70">
              Our core area is inner south Melbourne, but we occasionally take jobs further out.
              Call us and we'll tell you honestly — worst case, we'll point you to someone who can help.
            </p>
          </div>

          <div class="flex flex-col items-start gap-3 md:col-span-5 md:items-end">
            <a
              href={`tel:${business.phoneE164}`}
              class="group inline-flex items-center gap-3 rounded-full bg-ink px-6 py-4 text-paper transition-all hover:bg-brand"
            >
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M3 4a1 1 0 0 1 1-1h2l1 3-1.5 1A8 8 0 0 0 9 12l1-1.5 3 1v2a1 1 0 0 1-1 1A10 10 0 0 1 3 4Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
              </svg>
              <span class="font-display text-xl font-bold">{business.phone}</span>
            </a>
            <a
              href={`mailto:${business.email}`}
              class="text-sm font-medium text-ink/70 underline-offset-4 hover:text-ink hover:underline"
            >
              or email {business.email} →
            </a>
          </div>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>
