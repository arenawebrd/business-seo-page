---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { business } from '../../data/business';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.data.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const s = service.data;
---

<BaseLayout
  title={`${s.title} | Plumbing Co`}
  description={s.tagline}
  canonical={`/services/${s.slug}/`}
>
  <section class="container-x py-10 md:py-16">
    <div class="mx-auto max-w-4xl">
      {/* Hero */}
      <div class="text-center">
        <h1 class="font-display text-4xl font-bold tracking-tightest text-ink md:text-5xl lg:text-6xl">
          {s.hero.heading}
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-ink/70">
          {s.hero.sub}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="tel:+61390418200" class="btn-brand">
            Call {business.phone}
          </a>
          <a href="#pricing" class="btn-primary">
            See pricing
          </a>
        </div>
      </div>

      {/* Trust signals */}
      <div class="mt-12 flex flex-wrap justify-center gap-6 text-sm text-ink/60">
        {s.trust.map((item) => (
          <div class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8l3 3 7-7" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {item}
          </div>
        ))}
      </div>

      {/* Problems */}
      <div class="mt-16">
        <h2 class="font-display text-2xl font-bold tracking-tightest text-ink md:text-3xl">
          The problems we fix
        </h2>
        <div class="mt-6 grid gap-3 md:grid-cols-2">
          {s.problems.map((problem) => (
            <div class="flex items-start gap-3 rounded-xl border border-ink/10 bg-white p-4">
              <span class="mt-0.5 text-brand">→</span>
              <span class="text-sm text-ink/80">{problem}</span>
            </div>
          ))}
        </div>
      </div>

      {/* What's included */}
      <div class="mt-16">
        <h2 class="font-display text-2xl font-bold tracking-tightest text-ink md:text-3xl">
          What's included in every call-out
        </h2>
        <ul class="mt-6 space-y-3">
          {s.included.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span class="text-sm text-ink/80">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* Pricing */}
      <div id="pricing" class="mt-16">
        <h2 class="font-display text-2xl font-bold tracking-tightest text-ink md:text-3xl">
          Pricing — honest numbers
        </h2>
        <div class="mt-6 overflow-hidden rounded-2xl border border-ink/10 bg-white shadow-card">
          <table class="w-full">
            <thead>
              <tr class="border-b border-ink/10 bg-mist/30">
                <th class="px-6 py-4 text-left text-sm font-bold text-ink">What you're doing</th>
                <th class="px-6 py-4 text-right text-sm font-bold text-ink">Our flat price</th>
              </tr>
            </thead>
            <tbody>
              {s.pricing.map((item, i) => (
                <tr class={i < s.pricing.length - 1 ? 'border-b border-ink/10' : ''}>
                  <td class="px-6 py-4 text-sm text-ink/80">{item.what}</td>
                  <td class="px-6 py-4 text-right text-sm font-semibold text-ink">{item.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-ink/60">
          All prices include parts, labour, test flush, and leak check. No call-out fee bolted on at the end.
        </p>
      </div>

      {/* Testimonials */}
      <div class="mt-16">
        <h2 class="font-display text-2xl font-bold tracking-tightest text-ink md:text-3xl">
          What our customers say
        </h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {s.testimonials.map((t) => (
            <blockquote class="rounded-2xl border border-ink/10 bg-white p-6 shadow-card">
              <p class="text-sm leading-relaxed text-ink/80">"{t.quote}"</p>
              <footer class="mt-4 text-xs text-ink/60">
                — {t.author}, {t.suburb}
              </footer>
            </blockquote>
          ))}
        </div>
      </div>

      {/* FAQ */}
      <div class="mt-16">
        <h2 class="font-display text-2xl font-bold tracking-tightest text-ink md:text-3xl">
          Straight answers
        </h2>
        <dl class="mt-6 divide-y divide-ink/10 rounded-2xl border border-ink/10 bg-white shadow-card">
          {s.faqs.map((faq) => (
            <div class="p-6">
              <dt class="font-display text-base font-bold tracking-tight md:text-lg">
                {faq.q}
              </dt>
              <dd class="mt-2 text-sm leading-relaxed text-ink/75">{faq.a}</dd>
            </div>
          ))}
        </dl>
      </div>

      {/* CTA */}
      <div class="mt-16 text-center">
        <h2 class="font-display text-2xl font-bold tracking-tightest text-ink md:text-3xl">
          Ready to get it fixed?
        </h2>
        <p class="mt-4 text-ink/60">
          Same-day service across Melbourne's inner south. Call us or book online.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="tel:+61390418200" class="btn-brand">
            Call {business.phone}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
