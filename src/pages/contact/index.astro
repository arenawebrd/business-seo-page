---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { business } from '../../data/business';
---

<BaseLayout
  title="Contact us — Plumbing Co"
  description="Contact Plumbing Co — licensed plumbers in Prahran, Melbourne. Call (03) 9041 8200, email hello@plumbingco.com.au, or fill in the form."
  canonical="/contact/"
>
  <section class="container-x pt-10 pb-20 md:pt-16">
    <header class="mx-auto max-w-3xl text-center">
      <div class="eyebrow">Contact</div>
      <h1 class="mt-3 font-display text-4xl font-bold leading-[1.05] tracking-tightest md:text-6xl">
        Let's <span class="squiggle">talk.</span>
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-ink/70">
        Same-day service across Melbourne's inner south. Call now or fill in the form
        and we'll get back to you within the hour.
      </p>
    </header>

    <div class="mx-auto mt-14 grid max-w-5xl gap-10 lg:grid-cols-5">
      {/* Form */}
      <div class="lg:col-span-3">
        <form id="contact-form" data-email={business.email} class="rounded-3xl border border-ink/10 bg-white p-8 shadow-card md:p-10">
          <h2 class="font-display text-xl font-bold tracking-tight text-ink">
            Send us a message
          </h2>
          <p class="mt-2 text-sm text-ink/60">
            We'll reply within the hour during business hours.
          </p>

          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-medium text-ink">
                Name <span class="text-brand">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Your name"
                class="mt-2 w-full rounded-xl border border-ink/15 bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink/40 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-ink">
                Phone
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="(04) 0000 0000"
                class="mt-2 w-full rounded-xl border border-ink/15 bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink/40 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
              />
            </div>
          </div>

          <div class="mt-5">
            <label for="email" class="block text-sm font-medium text-ink">
              Email <span class="text-brand">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="you@example.com"
              class="mt-2 w-full rounded-xl border border-ink/15 bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink/40 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
            />
          </div>

          <div class="mt-5">
            <label for="suburb" class="block text-sm font-medium text-ink">
              Suburb
            </label>
            <select
              id="suburb"
              name="suburb"
              class="mt-2 w-full rounded-xl border border-ink/15 bg-paper px-4 py-3 text-sm text-ink focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
            >
              <option value="">Select your suburb</option>
              {business.serviceAreas.map((area) => (
                <option value={area}>{area}</option>
              ))}
              <option value="other">Other</option>
            </select>
          </div>

          <div class="mt-5">
            <label for="message" class="block text-sm font-medium text-ink">
              What's going on? <span class="text-brand">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows={5}
              placeholder="Tell us briefly what's happening — e.g. 'toilet keeps running', 'no hot water', 'kitchen tap dripping'"
              class="mt-2 w-full resize-none rounded-xl border border-ink/15 bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink/40 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
            />
          </div>

          <button
            type="submit"
            class="mt-6 w-full rounded-full bg-ink px-6 py-3.5 text-sm font-semibold text-paper transition-all hover:bg-brand focus:outline-none focus:ring-2 focus:ring-brand/40 focus:ring-offset-2"
          >
            Send message
          </button>
          <p class="mt-3 text-center text-xs text-ink/50">
            Or call us directly at{' '}
            <a href={`tel:${business.phoneE164}`} class="font-semibold text-brand hover:underline">
              {business.phone}
            </a>
          </p>
        </form>
      </div>

      {/* Sidebar info */}
      <div class="lg:col-span-2">
        <div class="space-y-6">
          {/* Phone */}
          <a
            href={`tel:${business.phoneE164}`}
            class="group flex items-center gap-4 rounded-2xl border border-ink/10 bg-white p-6 shadow-card transition-all hover:border-brand/30 hover:shadow-xl"
          >
            <div class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-brand-soft text-brand transition-colors group-hover:bg-brand group-hover:text-white">
              <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden>
                <path d="M3 4a1 1 0 0 1 1-1h2l1 3-1.5 1A8 8 0 0 0 9 12l1-1.5 3 1v2a1 1 0 0 1-1 1A10 10 0 0 1 3 4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.14em] text-ink/60">Call us</div>
              <div class="mt-1 font-display text-lg font-bold text-ink">{business.phone}</div>
            </div>
          </a>

          {/* Email */}
          <a
            href={`mailto:${business.email}`}
            class="group flex items-center gap-4 rounded-2xl border border-ink/10 bg-white p-6 shadow-card transition-all hover:border-brand/30 hover:shadow-xl"
          >
            <div class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-brand-soft text-brand transition-colors group-hover:bg-brand group-hover:text-white">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden>
                <path d="M3 8l9 6 9-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </div>
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.14em] text-ink/60">Email us</div>
              <div class="mt-1 font-display text-lg font-bold text-ink">{business.email}</div>
            </div>
          </a>

          {/* Address */}
          <div class="rounded-2xl border border-ink/10 bg-white p-6 shadow-card">
            <div class="flex items-center gap-4">
              <div class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-brand-soft text-brand">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden>
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"/>
                </svg>
              </div>
              <div>
                <div class="text-xs font-semibold uppercase tracking-[0.14em] text-ink/60">Visit us</div>
                <div class="mt-1 font-display text-lg font-bold text-ink">{business.address.suburb}</div>
              </div>
            </div>
            <p class="mt-3 text-sm text-ink/70">
              {business.address.street}<br />
              {business.address.suburb} {business.address.state} {business.address.postcode}
            </p>
          </div>

          {/* Hours */}
          <div class="rounded-2xl border border-ink/10 bg-white p-6 shadow-card">
            <div class="text-xs font-semibold uppercase tracking-[0.14em] text-ink/60">
              Business hours
            </div>
            <div class="mt-4 space-y-2">
              {business.hours.map((h) => (
                <div class="flex justify-between text-sm">
                  <span class="font-medium text-ink">{h.day}</span>
                  <span class="text-ink/60">
                    {h.close ? `${h.open} – ${h.close}` : h.open}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const emailBtn = form?.dataset.email || 'hello@plumbingco.com.au';
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const name = fd.get('name') || '';
    const email = fd.get('email') || '';
    const phone = fd.get('phone') || '';
    const suburb = fd.get('suburb') || '';
    const message = fd.get('message') || '';

    const subject = encodeURIComponent(`Plumbing enquiry from ${name}`);
    const body = encodeURIComponent(
      `Name: ${name}\nEmail: ${email}\nPhone: ${phone}\nSuburb: ${suburb}\n\nMessage:\n${message}`
    );
    window.location.href = `mailto:${emailBtn}?subject=${subject}&body=${body}`;
  });
</script>
