---
import Logo from './Logo.astro';
import { business } from '../../data/business';
---

<footer class="mt-24 border-t border-ink/10 bg-ink text-paper">
  <div class="container-x grid grid-cols-2 gap-10 py-16 md:grid-cols-4">
    <div class="col-span-2">
      <div class="text-paper">
        <Logo light />
      </div>
      <p class="mt-5 max-w-md text-sm leading-relaxed text-paper/70">
        {business.description}
      </p>
      <p class="mt-5 text-xs text-paper/50">
        Licence {business.licenseNumber} · ABN 12 345 678 910
      </p>
    </div>

    <div>
      <div class="text-xs font-semibold uppercase tracking-[0.18em] text-paper/60">
        Visit
      </div>
      <p class="mt-4 text-sm leading-relaxed text-paper/80">
        {business.address.street}<br />
        {business.address.suburb} {business.address.state} {business.address.postcode}
      </p>
      <a
        href={`tel:${business.phoneE164}`}
        class="mt-3 inline-block text-sm font-semibold text-paper hover:text-brand"
      >
        {business.phone}
      </a>
    </div>

    <div>
      <div class="text-xs font-semibold uppercase tracking-[0.18em] text-paper/60">
        Quick links
      </div>
      <ul class="mt-4 space-y-2 text-sm text-paper/80">
        <li><a href="/services/" class="hover:text-brand">Services</a></li>
        <li><a href="/blog/" class="hover:text-brand">Blog</a></li>
        <li><a href="/contact/" class="hover:text-brand">Contact</a></li>
        <li><a href="/locations/" class="hover:text-brand">Locations</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-paper/10">
    <div class="container-x flex flex-col items-start justify-between gap-3 py-6 text-xs text-paper/50 md:flex-row md:items-center">
      <span>© {new Date().getFullYear()} {business.legalName}. All rights reserved.</span>
      <span>Built with Astro · Statically rendered for speed.</span>
    </div>
  </div>
</footer>
