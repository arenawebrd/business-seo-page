---
import { business } from '../../data/business';

const whatsappNumber = business.phoneE164.replace('+', '');
const message = encodeURIComponent('Hi Plumbing Co, I need help with a plumbing issue.');
---

<a
  href={`https://wa.me/${whatsappNumber}?text=${message}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp"
  class="fixed bottom-6 right-6 z-50 grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-110 hover:shadow-xl md:bottom-8 md:right-8"
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.566-2.063-.087-.302-.015-.469.13-.62.136-.147.297-.347.445-.521.149-.173.199-.297.299-.497.1-.2.05-.375-.025-.524-.075-.149-.671-1.611-.919-2.204-.242-.579-.488-.5-.671-.509l-.572-.012c-.197 0-.52.074-.79.375-.27.3-1.03 1.005-1.03 2.448s1.055 2.834 1.198 3.031c.143.197 2.065 3.155 4.995 4.425.697.302 1.242.484 1.667.62.702.224 1.342.193 1.847.117.563-.084 1.758-.718 2.006-1.414.247-.696.247-1.293.173-1.414-.073-.122-.27-.197-.568-.347z" />
  </svg>
</a>
