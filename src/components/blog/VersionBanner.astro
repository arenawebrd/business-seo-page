---
type Tone = 'neutral' | 'warn' | 'good' | 'ink';

interface Props {
  version: string;
  title: string;
  body: string;
  tone?: Tone;
}

const { version, title, body, tone = 'neutral' } = Astro.props;

const toneClasses: Record<Tone, string> = {
  neutral: 'border-ink/10 bg-white text-ink/80',
  warn: 'border-amber-400/40 bg-amber-50 text-amber-900',
  good: 'border-emerald-400/40 bg-emerald-50 text-emerald-900',
  ink: 'border-ink/20 bg-ink text-paper',
};
---

<div class={`rounded-2xl border p-5 md:p-6 ${toneClasses[tone]}`}>
  <div class="text-xs font-semibold uppercase tracking-[0.18em] opacity-70">
    {version}
  </div>
  <div class="mt-1 font-display text-lg font-bold md:text-xl">{title}</div>
  <p class="mt-1.5 text-sm leading-relaxed opacity-90">{body}</p>
</div>
