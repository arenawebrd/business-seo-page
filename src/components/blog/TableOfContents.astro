---
export interface TocItem {
  id: string;
  label: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

<nav
  aria-label="On this page"
  class="rounded-2xl border border-ink/10 bg-white/60 p-5"
>
  <div class="text-xs font-semibold uppercase tracking-[0.18em] text-ink/60">
    On this page
  </div>
  <ol class="mt-3 space-y-2 text-sm">
    {items.map((item, i) => (
      <li class="flex gap-2">
        <span class="text-ink/70 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
        <a
          href={`#${item.id}`}
          class="text-ink/80 hover:text-brand hover:underline underline-offset-4"
        >
          {item.label}
        </a>
      </li>
    ))}
  </ol>
</nav>
