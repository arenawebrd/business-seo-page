---
export interface PexelsImage {
  file: string;
  alt: string;
  photographer: string;
  photographerUrl: string;
  pexelsUrl: string;
  width: number;
  height: number;
}

interface Props {
  image: PexelsImage;
  priority?: boolean;
  class?: string;
}

const { image, priority = false, class: className = '' } = Astro.props;
---

<figure class={`my-8 ${className}`}>
  <img
    src={image.file}
    alt={image.alt}
    width={image.width}
    height={image.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    sizes="(min-width: 768px) 720px, 100vw"
    class="aspect-[16/9] w-full rounded-2xl object-cover shadow-card"
  />
  <figcaption class="mt-2 text-center text-[11px] text-ink/70">
    Photo by{" "}
    <a
      href={image.photographerUrl}
      target="_blank"
      rel="noopener nofollow"
      class="text-ink/80 underline-offset-4 hover:text-ink hover:underline"
    >
      {image.photographer}
    </a>{" "}
    on{" "}
    <a
      href={image.pexelsUrl || 'https://www.pexels.com'}
      target="_blank"
      rel="noopener nofollow"
      class="text-ink/80 underline-offset-4 hover:text-ink hover:underline"
    >
      Pexels
    </a>
  </figcaption>
</figure>
